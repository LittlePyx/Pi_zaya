# Pi-zaya production environment template.
# Copy this file to .env, then replace every placeholder before starting server.py.

# Runtime mode. production makes readiness stricter but does not require user login by default.
KB_ENV=production

# Single-service production server used by server.py.
KB_SERVER_HOST=127.0.0.1
KB_SERVER_PORT=8000
KB_SERVER_RELOAD=0
KB_STARTUP_PREFLIGHT=1
KB_STARTUP_STRICT=0

# User-facing API access remains public so ordinary users can chat without a token.
KB_PRIVATE_INSTANCE_AUTH=0
KB_ENABLE_AUTH_GATE=0
KB_REQUIRE_AUTH=0
# Management writes are protected independently from user-facing chat.
KB_REQUIRE_MANAGEMENT_AUTH=1
# Set one of these before starting a public instance.
# KB_MANAGEMENT_ACCESS_TOKEN=replace-with-a-long-random-management-token
# KB_MANAGEMENT_ACCESS_TOKEN_SHA256=sha256-hex-of-management-token
# Local development ignores the auth gate unless this explicit test-only
# override is also enabled. Keep it 0 in checked-in and public templates.
KB_ALLOW_LOCAL_AUTH_GATE=0
# KB_ACCESS_TOKEN=replace-with-a-long-random-token-for-private-user-auth
# KB_ACCESS_TOKEN_SHA256=sha256-hex-if-you-do-not-want-plain-token-in-env
# For local HTTP testing set KB_AUTH_COOKIE_SECURE=0. Use 1 behind HTTPS.
KB_AUTH_COOKIE_SECURE=0

# Internal maintenance/diagnostic APIs are server-side disabled for public users.
# Keep this 0 in production unless the instance is a private/internal deployment.
KB_ENABLE_INTERNAL_API=0

# CORS. Keep this explicit in production; do not use "*".
KB_API_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Request body limits. Upload endpoints have their own file-size limits.
KB_API_JSON_MAX_BODY_BYTES=1048576
KB_USER_ISSUES_MAX_BODY_BYTES=65536
# Quality issue collection rate limits per client/IP. Set 0 only for trusted private testing.
KB_USER_ISSUES_LOCAL_RATE_LIMIT_PER_MIN=180
KB_USER_ISSUES_INGEST_RATE_LIMIT_PER_MIN=600
# Optional remote quality-data collection. Users must also enable the in-app
# sharing switch before anything is sent. Use the same secret on the sender
# (REMOTE_TOKEN) and collector (INGEST_TOKEN).
KB_USER_ISSUES_REMOTE_ENABLED=0
KB_USER_ISSUES_REMOTE_URL=
KB_USER_ISSUES_REMOTE_TOKEN=
KB_USER_ISSUES_INGEST_TOKEN=
# Local/private HTTP collectors are blocked by default; enable only for private tests.
KB_USER_ISSUES_ALLOW_LOCAL_REMOTE=0
KB_USER_ISSUES_ALLOW_UNAUTHENTICATED_REMOTE=0

# Persistent data paths. Prefer absolute paths outside temporary directories.
# Windows example: F:\research-papers\kb_chat_data\db
# Linux/macOS example: /srv/pi-zaya/db
KB_DB_DIR=/absolute/path/to/pi-zaya/db
KB_CHAT_DB=/absolute/path/to/pi-zaya/chat.sqlite3
KB_LIBRARY_DB=/absolute/path/to/pi-zaya/library.sqlite3
KB_BACKUP_DIR=/absolute/path/to/pi-zaya/backups
KB_DIAGNOSTICS_DIR=/absolute/path/to/pi-zaya/diagnostics

# Automatic snapshots before destructive operations. Enabled by default in production.
KB_AUTO_BACKUP=1
KB_AUTO_BACKUP_MIN_INTERVAL_S=30
KB_AUTO_BACKUP_STRICT=0
KB_BACKUP_KEEP_N=30
KB_RESTORE_AUDIT_PATH=/absolute/path/to/pi-zaya/restore_audit.jsonl

# Product version and update reminders. Use GitHub Releases as the stable update source.
KB_APP_VERSION=
KB_BUILD_COMMIT=
KB_BUILD_TIME=
KB_UPDATE_CHECK_ENABLED=1
KB_UPDATE_REPO=LittlePyx/Pi_zaya
KB_UPDATE_GITHUB_TOKEN=
KB_UPDATE_CHECK_TTL_S=3600
KB_UPDATE_CHECK_TIMEOUT_S=3

# Text model. DeepSeek is the preferred fast text provider when available.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# Flash defaults to direct, truly streamed answers. Use enabled for workloads
# where additional hidden reasoning is more important than first-token latency.
KB_DEEPSEEK_THINKING_MODE=disabled

# Vision model. Configure this for PDF image/table/figure work.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus-2026-05-26

# Optional OpenAI fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Runtime limits and background enrichment.
KB_LLM_TIMEOUT_S=60
KB_LLM_MAX_RETRIES=2
KB_CROSSREF_BUDGET_S=60

# Short-lived vision provider circuit breaker. Only consecutive timeout/429
# failures count; set the main switch to 0 to disable it immediately.
KB_PDF_VISION_CIRCUIT_BREAKER=1
KB_PDF_VISION_CIRCUIT_NORMAL_THRESHOLD=3
KB_PDF_VISION_CIRCUIT_NORMAL_COOLDOWN_S=30
KB_PDF_VISION_CIRCUIT_ULTRA_FAST_THRESHOLD=2
KB_PDF_VISION_CIRCUIT_ULTRA_FAST_COOLDOWN_S=45
KB_PDF_VISION_CIRCUIT_STATE_TTL_S=180
KB_PDF_VISION_CIRCUIT_MAX_ENTRIES=64

# PDF figure asset quality.
KB_PDF_FIGURE_DPI=320
