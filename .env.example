# Pi_zaya local development environment template.
# Copy this file to .env and fill at least one text-model API key.

KB_ENV=development

# Local app entry points.
KB_SERVER_HOST=127.0.0.1
KB_SERVER_PORT=8000
KB_SERVER_RELOAD=1
KB_STARTUP_PREFLIGHT=0
KB_STARTUP_STRICT=0

# Packaged builds set this to 1 and default user data to
# %LOCALAPPDATA%\Pi_zaya. Leave disabled for repository development.
KB_RELEASE_MODE=0
KB_APP_DATA_DIR=

# Local data paths. Relative paths are resolved from the repository root.
KB_DB_DIR=./db
KB_CHAT_DB=./chat.sqlite3
KB_LIBRARY_DB=./library.sqlite3
KB_BACKUP_DIR=./backups
KB_DIAGNOSTICS_DIR=./diagnostics

# Text model. Set one of these groups.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# Flash defaults to direct, truly streamed answers. Set to enabled only when
# the extra hidden reasoning latency is worth it for your workload.
KB_DEEPSEEK_THINKING_MODE=disabled

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Vision model for PDF figure/table work.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.7-plus-2026-05-26
QWEN_VISION_MODEL=qwen3-vl-plus
# Backward-compatible shared override. Prefer the two role-specific variables
# above so a text-model upgrade cannot change PDF conversion behavior.
QWEN_MODEL=

# Optional Research Agent web-search fallback for academic questions that are
# not sufficiently covered by the local library. Uses OPENAI_API_KEY by default.
KB_AGENT_WEB_SEARCH_ENABLED=0
KB_AGENT_WEB_SEARCH_API_KEY=
KB_AGENT_WEB_SEARCH_BASE_URL=https://api.openai.com/v1
KB_AGENT_WEB_SEARCH_MODEL=gpt-5-search-api
KB_AGENT_WEB_SEARCH_CONTEXT_SIZE=low

# Runtime limits.
KB_LLM_TIMEOUT_S=60
KB_LLM_MAX_RETRIES=2
KB_CROSSREF_BUDGET_S=60

# Background PDF concurrency. The shared process budget is divided across
# active documents; set 1 to prefer the lowest single-document latency.
KB_BG_CONVERT_MAX_ACTIVE=2

# Short-lived vision provider circuit breaker. Only consecutive timeout/429
# failures count; set the main switch to 0 to disable it immediately.
KB_PDF_VISION_CIRCUIT_BREAKER=1
KB_PDF_VISION_CIRCUIT_NORMAL_THRESHOLD=3
KB_PDF_VISION_CIRCUIT_NORMAL_COOLDOWN_S=30
KB_PDF_VISION_CIRCUIT_ULTRA_FAST_THRESHOLD=2
KB_PDF_VISION_CIRCUIT_ULTRA_FAST_COOLDOWN_S=45
KB_PDF_VISION_CIRCUIT_STATE_TTL_S=180
KB_PDF_VISION_CIRCUIT_MAX_ENTRIES=64

# Experimental, quality-first page budgets for normal vision conversion.
# Unknown, first, formula-sensitive, visual, and references pages retain the
# current quality envelope; enable only for measured real-PDF A/B runs first.
KB_PDF_VISION_ADAPTIVE_PAGE_BUDGETS=0

# Experimental: bypass full-page VL only for source-verified text-only pages.
# The local Markdown must pass coverage, order, length, table, and garble checks;
# rejected pages automatically continue through the existing VL path.
KB_PDF_VISION_TEXT_LOCAL_FASTPATH=0

# Local development keeps auth and internal APIs off by default.
KB_PRIVATE_INSTANCE_AUTH=0
KB_ENABLE_AUTH_GATE=0
KB_REQUIRE_AUTH=0
# Local development keeps management writes open. Production defaults to 1.
KB_REQUIRE_MANAGEMENT_AUTH=0
KB_MANAGEMENT_ACCESS_TOKEN=
KB_MANAGEMENT_ACCESS_TOKEN_SHA256=
KB_ENABLE_INTERNAL_API=0
